<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.EditarProduto"
             Title="{Binding Description}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>
    <VerticalStackLayout Spacing="10" Padding="20">
        <Label Text="Product ID"/>
        <Entry x:Name="txt_id" Text="{Binding Id}"/>
        <Label Text="Product Name"/>
        <Entry x:Name="txt_nome" Text="{Binding Name}"/>
        <Label Text="Product Description"/>
        <Entry x:Name="txt_desc" Text="{Binding Description}"/>
        <Label Text="Quantity"/>
        <Entry x:Name="txt_qtd" Keyboard="Numeric" Text="{Binding Quantity}"/>
        <Label Text="Price"/>
        <Entry x:Name="txt_preco" Keyboard="Numeric" Text="{Binding Price}"/>
    </VerticalStackLayout>
</ContentPage>