<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Lista de Produtos">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sum" Clicked="ToolbarItem_Clicked_Soma" />
        <ToolbarItem Text="Add" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>
    <VerticalStackLayout>
        <SearchBar x:Name="txt_search"
                   Placeholder="Search Products"
                   TextChanged="txt_search_TextChanged" />
        <ListView x:Name="list_produtos" ItemSelected="list_produtos_ItemSelected">
            <ListView.Header>
                <Grid ColumnDefinitions="*,*,*,*,*,*">
                    <Label Grid.Column="0" Text="Name"/>
                    <Label Grid.Column="1" Text="ID" />
                    <Label Grid.Column="2" Text="Description" />
                    <Label Grid.Column="3" Text="Price" />
                    <Label Grid.Column="4" Text="Quantity" />
                    <Label Grid.Column="5" Text="Total" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.ContextActions>
                            <MenuItem Text="Delete" Clicked="MenuItem_Clicked" />
                        </ViewCell.ContextActions>
                        <Grid ColumnDefinitions="*,*,*,*,*,*">
                            <Label Grid.Column="0" Text="{Binding Name}"/>
                            <Label Grid.Column="1" Text="{Binding Id}" />
                            <Label Grid.Column="2" Text="{Binding Description}" />
                            <Label Grid.Column="3" Text="{Binding Price}" />
                            <Label Grid.Column="4" Text="{Binding Quantity}" />
                            <Label Grid.Column="5" Text="{Binding Total}" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>