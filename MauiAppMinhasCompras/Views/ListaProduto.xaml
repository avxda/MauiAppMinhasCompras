<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Lista de Produtos">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sum" Clicked="ToolbarItem_Clicked_Soma" />
        <ToolbarItem Text="Add" Clicked="ToolbarItem_Clicked" />
        <ToolbarItem Text="Report" Clicked="ToolbarItem_Clicked_Relatorio" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout>
        <SearchBar x:Name="txt_search"
                   Placeholder="Search Products"
                   TextChanged="txt_search_TextChanged" />
        <Frame Padding="0" Margin="10" VerticalOptions="FillAndExpand">
            <ListView x:Name="list_produtos" ItemSelected="list_produtos_ItemSelected"
                    IsPullToRefreshEnabled="True"
                    Refreshing="list_produtos_Refreshing">
                <ListView.Header>
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" BackgroundColor="DodgerBlue">
                        <Label Grid.Column="0" Text="Name" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Grid.Column="1" Text="ID" FontAttributes="Bold"/>
                        <Label Grid.Column="2" Text="Description" FontAttributes="Bold"/>
                        <Label Grid.Column="3" Text="Price" FontAttributes="Bold"/>
                        <Label Grid.Column="4" Text="Quantity" FontAttributes="Bold"/>
                        <Label Grid.Column="5" Text="Date" FontAttributes="Bold"/>
                        <Label Grid.Column="6" Text="Total" FontAttributes="Bold"/>

                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem Text="Delete" Clicked="MenuItem_Clicked" />
                            </ViewCell.ContextActions>
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                                <Label Grid.Column="0" Text="{Binding Name}" HorizontalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding Id}" />
                                <Label Grid.Column="2" Text="{Binding Description}" />
                                <Label Grid.Column="3" Text="{Binding Price, StringFormat='{}{0:C}'}" />
                                <Label Grid.Column="4" Text="{Binding Quantity}" />
                                <Label Grid.Column="5" Text="{Binding DataCadastro, StringFormat='{}{0:MM/dd/yyyy}'}" />
                                <Label Grid.Column="6" Text="{Binding Total, StringFormat='{}{0:C}'}" />

                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Frame>
    </StackLayout>
</ContentPage>